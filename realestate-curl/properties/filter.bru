meta {
  name: filter
  type: http
  seq: 5
}

get {
  url: http://localhost:3001/properties/filters/?city=Madrid&type=HOUSE&operation=SALE
  body: none
  auth: inherit
}

params:query {
  city: Madrid
  type: HOUSE
  operation: SALE
  ~status: USED
  ~minPrice: 200000
  ~maxPrice: 800000
  ~rooms: 4
  ~bathrooms: 3
}

settings {
  encodeUrl: false
  timeout: 0
}
